{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "operationId": "UsersController_login",
        "summary": "Login user",
        "description": "Authenticate using email and password.",
        "parameters": [
          {
            "name": "role",
            "in": "header",
            "description": "User role (required for all endpoints)",
            "required": true,
            "schema": {
              "enum": [
                "client",
                "lawyer",
                "intern",
                "firmadmin",
                "superadmin"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "tags": [
          "users"
        ]
      }
    },
    "/users": {
      "post": {
        "operationId": "UsersController_create",
        "summary": "Create a new user",
        "description": "Creates a new user with the specified role (client, lawyer, intern, firmadmin, superadmin). Only firmadmins/superadmins can create users.",
        "parameters": [
          {
            "name": "role",
            "in": "header",
            "description": "User role (required for all endpoints)",
            "required": true,
            "schema": {
              "enum": [
                "client",
                "lawyer",
                "intern",
                "firmadmin",
                "superadmin"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data"
          },
          "403": {
            "description": "Forbidden - only firmadmin role can create users"
          }
        },
        "tags": [
          "users"
        ]
      },
      "get": {
        "operationId": "UsersController_findAll",
        "summary": "Get all users",
        "description": "Retrieve all users or filter by role. Only firmadmins and superadmins can view all users.",
        "parameters": [
          {
            "name": "role",
            "in": "header",
            "description": "User role (required for all endpoints)",
            "required": true,
            "schema": {
              "enum": [
                "client",
                "lawyer",
                "intern",
                "firmadmin",
                "superadmin"
              ],
              "type": "string"
            }
          },
          {
            "name": "role",
            "required": false,
            "in": "query",
            "description": "Filter users by role",
            "schema": {
              "enum": [
                "client",
                "lawyer",
                "intern",
                "firmadmin",
                "superadmin"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserResponseDto"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - only firmadmin role can view all users"
          }
        },
        "tags": [
          "users"
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "operationId": "UsersController_findOne",
        "summary": "Get user by ID (all roles)",
        "description": "Retrieve a specific user by their ID. Available to all roles.",
        "parameters": [
          {
            "name": "role",
            "in": "header",
            "description": "User role (required for all endpoints)",
            "required": true,
            "schema": {
              "enum": [
                "client",
                "lawyer",
                "intern",
                "firmadmin",
                "superadmin"
              ],
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - role header is required"
          },
          "404": {
            "description": "User not found"
          }
        },
        "tags": [
          "users"
        ]
      }
    },
