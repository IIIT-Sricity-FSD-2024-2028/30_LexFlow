# PostgreSQL connection string (Aiven: copy from the Aiven console, includes ?sslmode=require)
DATABASE_URL=postgres://user:password@host.aivencloud.com:12345/defaultdb?sslmode=require
PORT=3000
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=1h

# Optional first administrator for a new database. Clear after setup.
INITIAL_PLATFORM_ADMIN_EMAIL=
INITIAL_PLATFORM_ADMIN_PASSWORD=
